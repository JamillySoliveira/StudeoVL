rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // AUTENTICAÇÃO
    // ============================================================

    function isAuthenticated() {
      return request.auth != null;
    }


    // ============================================================
    // ADMIN
    // ============================================================

    function isAdmin() {
      return isAuthenticated()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == "admin";
    }


    // ============================================================
    // ACESSO À PLATAFORMA
    // ============================================================

    function hasActiveAccess() {
      return isAuthenticated()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.accessEnabled == true;
    }


    // ============================================================
    // MATRÍCULA EM CURSO
    //
    // O aluno só lê o conteúdo (curso, módulos e aulas com links de
    // vídeo) dos cursos liberados no perfil dele: enrolledCourses ou
    // courseAccess. Mesma lógica de getUserAccessibleCourseIds() no app.
    //
    // Cada curso tem o ID oficial e um ID antigo (dados legados):
    //   rockwell-basico                  <- rockwell-controle-analogico-supervisorio
    //   rControl-entrada-saida-analogica <- rockwell-intermediario
    //   IHM-supervisorio                 <- rockwell-avancado
    // ============================================================

    function courseIdGroup(courseId) {
      let basico = ['rockwell-basico', 'rockwell-controle-analogico-supervisorio'];
      let controle = ['rControl-entrada-saida-analogica', 'rockwell-intermediario'];
      let ihm = ['IHM-supervisorio', 'rockwell-avancado'];

      return courseId in basico ? basico
        : courseId in controle ? controle
        : courseId in ihm ? ihm
        : [courseId, courseId];
    }

    function isEnrolledIn(courseId) {
      let u = get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
      let enrolled = u.get('enrolledCourses', []);
      let access = u.get('courseAccess', {});
      let ids = courseIdGroup(courseId);

      return enrolled.hasAny(ids)
        || access.get(ids[0], false) == true
        || access.get(ids[1], false) == true;
    }

    function canReadCourseContent(courseId) {
      return isAdmin() || (hasActiveAccess() && isEnrolledIn(courseId));
    }


    // ============================================================
    // USUÁRIOS
    // ============================================================

    match /users/{userId} {

      // ----------------------------------------------------------
      // LEITURA
      // ----------------------------------------------------------

      allow read: if isAuthenticated()
        && (
          request.auth.uid == userId
          || isAdmin()
        );


      // ----------------------------------------------------------
      // CRIAÇÃO
      //
      // Novo aluno:
      // - somente o próprio UID
      // - role student
      // - plataforma bloqueada
      //
      // enrolledCourses não é mais obrigatório.
      // courseAccess também começa bloqueado.
      // ----------------------------------------------------------

      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.role == "student"
        && request.resource.data.accessEnabled == false;


      // ----------------------------------------------------------
      // ATUALIZAÇÃO
      //
      // ADMIN:
      // pode alterar qualquer informação.
      //
      // ALUNO:
      // somente dados pessoais (nome, e-mail, foto...).
      //
      // Usa diff().affectedKeys() em vez de comparar campo a campo:
      // comparar um campo que não existe no documento (ex.: aluno novo
      // sem enrolledCourses) gera erro na regra e bloqueava a atualização.
      // ----------------------------------------------------------

      allow update: if isAuthenticated()
        && (
          isAdmin()

          ||

          (
            request.auth.uid == userId
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'role',
              'accessEnabled',
              'courseAccess',
              'enrolledCourses'
            ])
          )
        );


      // ----------------------------------------------------------
      // EXCLUSÃO
      // ----------------------------------------------------------

      allow delete: if isAdmin();
    }


    // ============================================================
    // PROGRESSO
    // ============================================================

    // O ID do documento segue o formato "{uid}_{courseId}".
    // A posse é verificada pelo ID do documento, e não só pelo campo userId:
    // - impede que um aluno crie "OUTRO-UID_curso" e bloqueie o progresso do colega;
    // - permite ler um progresso que ainda não existe (curso novo) sem erro de permissão.

    function ownsProgressDoc(progressId) {
      return isAuthenticated()
        && progressId.matches(request.auth.uid + '_.+');
    }

    match /progress/{progressId} {

      allow read: if isAdmin() || ownsProgressDoc(progressId);

      allow create: if ownsProgressDoc(progressId)
        && request.resource.data.userId == request.auth.uid;

      allow update: if isAdmin()
        || (
          ownsProgressDoc(progressId)
          && request.resource.data.userId == request.auth.uid
        );

      allow delete: if isAdmin() || ownsProgressDoc(progressId);
    }


    // ============================================================
    // CURSOS
    // ============================================================

    match /courses/{courseId} {

      allow read: if canReadCourseContent(courseId);

      allow write: if isAdmin();
    }


    // ============================================================
    // MÓDULOS
    // ============================================================

    match /modules/{moduleId} {

      allow read: if canReadCourseContent(resource.data.courseId);

      allow write: if isAdmin();
    }


    // ============================================================
    // AULAS
    // ============================================================

    match /lessons/{lessonId} {

      allow read: if canReadCourseContent(resource.data.courseId);

      allow write: if isAdmin();
    }


    // ============================================================
    // AULAS EXCLUÍDAS
    //
    // O aluno também precisa ler esta lista: o app usa ela para
    // esconder aulas que o admin excluiu.
    // ============================================================

    match /deletedLessons/{lessonId} {

      allow read: if isAdmin() || hasActiveAccess();

      allow write: if isAdmin();
    }


    // ============================================================
    // AVISOS (COMUNICADOS)
    //
    // Admin publica e exclui. Aluno ativo lê somente os avisos dos
    // cursos em que está matriculado.
    // ============================================================

    match /notices/{noticeId} {

      allow read: if canReadCourseContent(resource.data.courseId);

      allow create: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.message is string
        && request.resource.data.courseId is string;

      allow update, delete: if isAdmin();
    }


    // ============================================================
    // BLOQUEIO PADRÃO
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
